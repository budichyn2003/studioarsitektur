generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectCategory {
  RESIDENTIAL
  PUBLIC
  INSTALLATION
}

model Project {
  id            String          @id @default(uuid())
  slug          String          @unique
  title         String
  category      ProjectCategory
  location      String          
  architect     String?
  photographer  String?
  interior      String?
  descriptionEn String?         @db.Text
  descriptionId String?         @db.Text
  projectDate   DateTime        @default(now())
  images        ProjectImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  buildYear         String?
  status            String?
  architectInCharge String?  
  drafter           String?
  siteArea          String?  
  constructedArea   String?
  collaborate       String?
  photographs       String?  
}

model ProjectImage {
  id        String   @id @default(uuid())
  url       String
  width     Int      @default(1920)
  height    Int      @default(1080)
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model News {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  contentEn     String?  @db.Text
  contentId     String?  @db.Text
  thumbnailUrl  String?
  imageUrls     String[] // TAMBAHAN REVISI: Untuk mendukung multiple images
  externalLink  String?
  publishDate   DateTime
  author        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Career {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String   
  location     String   
  type         String   
  description  String   @db.Text
  requirements String   @db.Text
  isActive     Boolean  @default(true) 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomepageSetting {
  id            String   @id @default(uuid())
  title         String   @default("Main Homepage")
  imageUrls     String[] 
  delayTimer    Int      @default(3000) 
  showAboutHero Boolean  @default(false) 
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// ==========================================
// TAMBAHAN FIELD BARU REVISI CLIENT (CMS)
// ==========================================

model AboutSetting {
  id         String   @id @default(uuid())
  title      String   @default("ABOUT US")
  content    String   @db.Text
  showHero   Boolean  @default(true)
  heroUrl    String   @default("https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?q=80&w=2070&auto=format&fit=crop")
  thumbnails String[] // Menyimpan 4 array url gambar thumbnail koleksi bawah
  updatedAt  DateTime @updatedAt
}

model ContactSetting {
  id           String   @id @default(uuid())
  headline     String   @default("Let's discuss \nyour next project.")
  subheadline  String   @db.Text
  email        String   @default("hello@architecture.com")
  phone        String   @default("+62 812 3456 7890")
  address      String   @default("Jl. Sudirman No. 123, Jakarta Selatan, Indonesia 12190")
  calendlyLink String?  // INI JANGAN LUPA DITAMBAHKAN
  bannerUrl    String   @default("https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?q=80&w=2070&auto=format&fit=crop")
  updatedAt    DateTime @updatedAt
}

// INI JUGA JANGAN LUPA DITAMBAHKAN DI BAWAHNYA
model SocialMediaSetting {
  id        String   @id @default(uuid())
  instagram String?
  youtube   String?
  linkedin  String?
  updatedAt DateTime @updatedAt
}

model NewsSetting {
  id        String   @id @default(uuid())
  bannerUrl String   @default("https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=2070&auto=format&fit=crop")
  updatedAt DateTime @updatedAt
}

model CareerSetting {
  id        String   @id @default(uuid())
  bannerUrl String   @default("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop")
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormerMember {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}