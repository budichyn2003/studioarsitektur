generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectCategory {
  RESIDENTIAL
  PUBLIC
  INSTALLATION
}

model Project {
  id            String          @id @default(uuid())
  slug          String          @unique
  title         String
  category      ProjectCategory
  location      String          // <--- Ini location yang asli, kita pertahankan
  architect     String?
  photographer  String?
  interior      String?
  descriptionEn String?         @db.Text
  descriptionId String?         @db.Text
  projectDate   DateTime        @default(now())
  images        ProjectImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // --- TAMBAHAN FIELD BARU SESUAI DESAIN UI ---
  buildYear         String?  // Tahun Terbangun / Terdesign
  status            String?  // misal: "Build" atau "Design"
  architectInCharge String?  
  drafter           String?  
  siteArea          String?  // misal: "120 m2"
  constructedArea   String?  // misal: "200 m2"
  collaborate       String?  
  photographs       String?  
}

model ProjectImage {
  id        String   @id @default(uuid())
  url       String
  width     Int      @default(1920)
  height    Int      @default(1080)
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model News {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  contentEn     String?  @db.Text
  contentId     String?  @db.Text
  thumbnailUrl  String?
  externalLink  String?
  publishDate   DateTime 
  author        String?  // <--- TAMBAHAN UNTUK PENULIS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Career {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String   // Nama posisi (ex: Junior Architect)
  location     String   // Lokasi kerja (ex: Jakarta, Indonesia)
  type         String   // Full-Time, Part-Time, Internship
  description  String   @db.Text
  requirements String   @db.Text
  isActive     Boolean  @default(true) // Untuk mematikan/menyalakan lowongan
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomepageSetting {
  id          String   @id @default(uuid())
  title       String   @default("Main Homepage")
  imageUrls   String[] // Menyimpan banyak URL gambar sekaligus (Array)
  delayTimer  Int      @default(3000) // Waktu delay antar gambar (dalam milidetik)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}